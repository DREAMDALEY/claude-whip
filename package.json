{
  "name": "claude-whip",
  "version": "0.1.0",
  "description": "Crack the whip on Claude Code - parallel agent orchestration from your terminal",
  "type": "module",
  "bin": {
    "claude-whip": "./bin/claude-whip.js"
  },
  "scripts": {
    "build": "tsup src/cli.tsx --format esm --outDir dist",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["claude", "claude-code", "ai", "agents", "parallel", "orchestration", "cli"],
  "author": "Ethan Daley <ethandaley780@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/campx9/claude-whip"
  },
  "dependencies": {
    "ink": "^6.0.0",
    "react": "^19.0.0",
    "commander": "^13.0.0",
    "chalk": "^5.4.0",
    "nanoid": "^5.0.0",
    "execa": "^9.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "@types/react": "^19.0.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
